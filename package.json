{
  "name": "beautymatch-frontend",
  "private": true,
  "scripts": {
    "dev": "node scripts/preview_frontend.mjs",
    "test": "node --test tests/frontend/*.test.mjs",
    "test:e2e": "playwright test",
    "test:live": "node scripts/verify_crm_native.mjs --exercise-flow",
    "format:check": "prettier --check \"beautymatch/public/js/*.mjs\" \"beautymatch/public/css/*.css\" \"tests/frontend/*.mjs\" \"tests/browser/*.mjs\" \"scripts/*.mjs\" playwright.config.mjs",
    "check": "node scripts/check_frontend.mjs",
    "test:visual": "node scripts/capture_botanical.mjs",
    "test:crm": "node scripts/verify_crm_native.mjs",
    "test:crm:crud": "node scripts/verify_crm_native.mjs --exercise-flow",
    "test:crm:sidebar": "node scripts/verify_crm_native.mjs",
    "test:crm:native": "node scripts/verify_crm_native.mjs",
    "test:crm:task": "node scripts/verify_crm_task.mjs",
    "test:seminar": "node scripts/verify_seminar.mjs",
    "test:consistency": "node scripts/verify_request_consistency.mjs",
    "test:portal:notifications": "node scripts/verify_portal_notifications.mjs",
    "test:self-service": "node scripts/verify_self_service.mjs",
    "test:demo:photos": "node scripts/verify_demo_photos.mjs",
    "test:crm:native:flow": "node scripts/verify_crm_native.mjs --exercise-flow"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
